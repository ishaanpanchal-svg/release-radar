# Copy this file to .env.local and fill in the values. Never commit .env.local.

# GitHub personal access token (classic, NO scopes ticked: it only reads public data).
# Without it GitHub allows 60 requests/hour; with it, 5000.
GITHUB_TOKEN=

# Google AI Studio key (https://aistudio.google.com/apikey). All AI calls use Gemini Flash models.
GEMINI_API_KEY=
# Optional: first model to try. Defaults to gemini-3.8-flash, then falls back through other Flash models.
# GEMINI_MODEL=

# Supabase project (Project Settings > API). The secret key is used on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (https://resend.com). On the free plan without your own domain, mail can only go to the address you signed up with.
RESEND_API_KEY=
DIGEST_TO_EMAIL=
# Optional sender. Defaults to Release Radar <onboarding@resend.dev>
# RESEND_FROM=

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" so only Vercel can trigger the Monday run.
# Production only. Make up a long random string.
CRON_SECRET=

# Optional: public URL of the deployed dashboard (used for the button in the email).
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
